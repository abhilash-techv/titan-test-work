CREATE TABLE transactionsdata(
    id SERIAL NOT NULL,
    transactionid text,
    oldloyaltyid text,
    cardno text,
    tiername text,
    rewardpostingdate date,
    invoice_no varchar,
    invoice_date date,
    channel text,
    category text,
    brand text,
    qty bigint,
    storecode text,
    campaignname text,
    currencysymbol text,
    shopping_amount numeric(15,3),
    eligible_amount numeric(15,4),
    earn numeric(15,4),
    spent numeric(15,4),
    remarkstype text,
    remarks text,
    discountheader numeric(15,5),
    earned_invoicedate date,
    earned_invoicenumber varchar,
    earned_channel text,
    earned_outlet text,
    earned_lineitemnumber numeric(15,5),
    PRIMARY KEY(id)
);
